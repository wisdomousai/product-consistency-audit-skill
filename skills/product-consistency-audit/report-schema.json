{
  "$comment": "Top-level contract for findings.json. validate-findings.cjs interprets and checks this schema directly.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "description": "A source-grounded gap between intent and implementation that was independently established.",
        "properties": {
          "verdict": {
            "type": "string",
            "const": "confirmed"
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
            "description": "A stable source-derived identifier that does not change between verdicts."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "capability": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "person": {
            "type": "object",
            "description": "The person the capability serves and the goal affected.",
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "goal": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              }
            },
            "required": [
              "role",
              "goal"
            ],
            "additionalProperties": false
          },
          "fit": {
            "type": "string",
            "enum": [
              "underfit",
              "overfit",
              "inconsistency"
            ]
          },
          "fit_class": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true,
            "pattern": "^[A-Z0-9][A-Z0-9-]*\\.md#\\S(?:.*\\S)?$",
            "description": "Block reference: FILE.md# plus the exact class heading."
          },
          "principles": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P[1-9][0-9]*$"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "IDs from PRINCIPLES.md that this record cites."
          },
          "intent": {
            "type": "object",
            "properties": {
              "purpose": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "file",
                        "commit"
                      ]
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Repository-relative path for kind file; commit hash for kind commit."
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "visibleContent": true
                    }
                  },
                  "required": [
                    "kind",
                    "ref",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "purpose",
              "sources"
            ],
            "additionalProperties": false
          },
          "root_cause": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "entrypoint",
                    "transition",
                    "outcome"
                  ]
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                }
              },
              "required": [
                "kind",
                "file",
                "line",
                "scope",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                }
              },
              "required": [
                "file",
                "line",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "role",
                    "plan_or_entitlement",
                    "session_state",
                    "data_state",
                    "prior_action",
                    "device_or_browser",
                    "timing",
                    "provider_dependency",
                    "deployment_config"
