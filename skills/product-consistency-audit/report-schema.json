                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                }
              },
              "required": [
                "kind",
                "description"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "reproduction": {
            "type": "object",
            "description": "How the gap was established, in the target's own terms.",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "source",
                  "history",
                  "local_walkthrough"
                ]
              },
              "setup": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "steps": {
                "type": "array",
                "minItems": 1,
