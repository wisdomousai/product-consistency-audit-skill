            },
            "required": [
              "strategy"
            ],
            "additionalProperties": false
          },
          "severity": {
            "type": "object",
            "properties": {
              "likelihood": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "string",
                    "enum": [
                      "informational",
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "visibleContent": true
                  }
                },
                "required": [
                  "score",
                  "reason"
                ],
                "additionalProperties": false
              },
              "impact": {
                "type": "object",
